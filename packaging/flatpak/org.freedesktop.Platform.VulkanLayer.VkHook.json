{
  "id": "org.freedesktop.Platform.VulkanLayer.VkHook",
  "branch": "26.08",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "build-extension": true,
  "modules": [
    {
      "name": "spirv-headers",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p ${FLATPAK_DEST}/include/spirv",
        "cp -r include/spirv ${FLATPAK_DEST}/include/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/KhronosGroup/SPIRV-Headers.git",
          "tag": "vulkan-sdk-1.4.350.1"
        }
      ]
    },
    {
      "name": "glslang",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_PREFIX=/usr/lib/extensions/vulkan/VkHook",
        "-DBUILD_SHARED_LIBS=OFF",
        "-DBUILD_EXTERNAL=OFF",
        "-DENABLE_OPT=OFF",
        "-DGLSLANG_TESTS=OFF"
      ],
      "cleanup": ["*"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/KhronosGroup/glslang.git",
          "tag": "16.6.0",
          "commit": "e1b562a8bed273a02f30b59b66a5d499793cede5"
        }
      ]
    },
    {
      "name": "vkhook",
      "buildsystem": "meson",
      "build-options": {
        "env": {
          "CC": "/usr/lib/sdk/llvm22/bin/clang",
          "CXX": "/usr/lib/sdk/llvm22/bin/clang++",
          "CPPFLAGS": "-I/usr/lib/extensions/vulkan/VkHook/include"
        },
        "prepend-path": "/usr/lib/extensions/vulkan/VkHook/bin",
        "prepend-pkg-config-path": "/usr/lib/extensions/vulkan/VkHook/lib/pkgconfig"
      },
      "config-opts": [
        "--buildtype=release",
        "--prefix=/usr/lib/extensions/vulkan/VkHook",
        "--libdir=/usr/lib/extensions/vulkan/VkHook/lib",
        "-Dappend_libdir_vkhook=false",
        "-Dwith_so=true",
        "-Dwith_json=true",
        "-Ddlss5=enabled",
        "-Dcpp_args=-I/usr/lib/extensions/vulkan/VkHook/include"
      ],
      "sources": [
        {
          "type": "git",
          "path": "../..",
          "branch": "main"
        }
      ]
    }
  ]
}

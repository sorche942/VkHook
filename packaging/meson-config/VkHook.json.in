{
  "file_format_version" : "1.0.0",
  "layer" : {
    "name": "VK_LAYER_VKHOOK_post_processing",
    "type": "GLOBAL",
    "library_path": "@layer_library_path@",
    "api_version": "1.3.223",
    "implementation_version": "@layer_version@",
    "description": "a post processing layer with overlay UI",
    "functions": {
      "vkGetInstanceProcAddr": "VkHook_GetInstanceProcAddr",
      "vkGetDeviceProcAddr":   "VkHook_GetDeviceProcAddr"
    },
    "enable_environment": {
      "ENABLE_VKHOOK": "1"
    },
    "disable_environment": {
      "DISABLE_VKHOOK": "1"
    }
  }
}

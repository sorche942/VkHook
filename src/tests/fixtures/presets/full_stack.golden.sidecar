[VKHOOK]
Effects=qUINT_bloom.fx|Bloom, LumaStack.fx|LumaPre, qUINT_bloom.fx|Bloom|2, *LumaStack.fx|LumaPost, *Vibrance.fx|Vibrance, DLSS5, Tonemap.fx|Tonemap

[qUINT_bloom.fx|Bloom]
PreprocessorDefinitions=BLOOM_QUALITY=2
BLOOM_INT=0.500000
BLOOM_TINT=1.000000,0.500000,0.250000

[qUINT_bloom.fx|Bloom|2]
PreprocessorDefinitions=BLOOM_QUALITY=float2(1,,2)
BLOOM_INT=1.500000
BLOOM_TINT=0.000000,0.000000,1.000000

[LumaStack.fx|LumaPost]
Strength=0.400000

[Vibrance.fx|Vibrance]
PreprocessorDefinitions=VIB_TINT=float3(1,,0,,0),VIB_MODE=1
Vibrance=0.750000
Vibrance_RGB_balance=1.000000,0.900000,0.800000
